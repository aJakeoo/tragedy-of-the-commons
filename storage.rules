rules_version = '2';

// Tragedy of the Commons - no auth, room-code-gated by obscurity only,
// matching firestore.rules. Anyone with a room's code can read/write video
// uploads scoped under that room's own path; everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /rooms/{code}/uploads/{allPaths=**} {
      allow read, write: if true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
